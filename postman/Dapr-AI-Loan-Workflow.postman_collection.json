    {
      "name": "📋 3. Dapr Workflow (Direct API)",
      "description": "Dapr Workflow orchestrating multiple AI agents.\nWorkflow activities: DocumentVerification → CreditCheck → Eligibility → Approval",
      "item": [
        {
          "name": "3.1 Submit Loan Application",
          "event": [{"listen": "test", "script": {"exec": ["var jsonData = pm.response.json();", "if (jsonData.instanceId) { pm.collectionVariables.set('instanceId', jsonData.instanceId); }"]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"applicantName\": \"Rahul Sharma\",\n  \"panNumber\": \"BSRPS1234K\",\n  \"aadhaarNumber\": \"499118665246\",\n  \"annualIncome\": 2400000,\n  \"requestedLoanAmount\": 5000000,\n  \"loanTenureYears\": 20,\n  \"creditScore\": 780,\n  \"existingEmi\": 10000,\n  \"employmentType\": \"SALARIED\",\n  \"employerName\": \"TCS\",\n  \"yearsOfExperience\": 8,\n  \"propertyType\": \"APARTMENT\",\n  \"propertyValue\": 8000000,\n  \"propertyLocation\": \"Mumbai\"\n}"},
            "url": "{{baseUrl}}/api/loan/apply",
            "description": "Start Dapr Workflow with 4 AI Agent activities.\nReturns instanceId for tracking."
          }
        },
        {
          "name": "3.2 Get Workflow Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/loan/status/{{instanceId}}",
            "description": "Get current status of the workflow.\nStates: RUNNING, COMPLETED, FAILED, SUSPENDED"
          }
        },
        {
          "name": "3.3 Wait for Completion",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/loan/wait/{{instanceId}}?timeoutSeconds=120",
            "description": "Wait for workflow to complete (blocking call).\nTimeout: 120 seconds"
          }
        },
        {
          "name": "3.4 Submit Sample Application",
          "event": [{"listen": "test", "script": {"exec": ["var jsonData = pm.response.json();", "if (jsonData.instanceId) { pm.collectionVariables.set('instanceId', jsonData.instanceId); }"]}}],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/loan/sample",
            "description": "Submit a pre-configured sample application"
          }
        }
      ]
    },
